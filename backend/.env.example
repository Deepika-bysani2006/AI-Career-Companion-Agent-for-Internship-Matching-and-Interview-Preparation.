# SkillBridge Backend Environment Configuration Template
# DO NOT COMMIT REAL PRODUCTION SECRETS OR API KEYS TO GIT

# Server & CORS
PORT=8000
FRONTEND_URL=https://frontend-eight-sigma-kit01hsku5.vercel.app

# PostgreSQL Database (Neon / Render / Docker / Local)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=skillbridge_db
POSTGRES_USER=skillbridge
POSTGRES_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql://skillbridge:your_postgres_password_here@127.0.0.1:5432/skillbridge_db

# Security & JWT Token Keys
JWT_SECRET=your_jwt_secret_key_here
SECRET_KEY=your_secret_key_here

# Firebase & Google Authentication (Backend Client Validation)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Production AI Engine (Google Gemini API)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Local AI Engine (Ollama Desktop)
AI_PROVIDER=gemini
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Apify Job Scraping Token
APIFY_API_TOKEN=your_apify_api_token_here
