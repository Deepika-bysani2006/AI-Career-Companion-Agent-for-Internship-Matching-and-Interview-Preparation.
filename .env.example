# Application Configuration
PROJECT_NAME="SkillBridge – AI Internship Application Agent"
VERSION=1.0.0
API_V1_STR=/api/v1

# PostgreSQL Configuration
# For local Windows development: POSTGRES_HOST=localhost
# For Docker Compose: POSTGRES_HOST=postgres (handled automatically by Docker Compose)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=skillbridge_db
POSTGRES_USER=skillbridge
POSTGRES_PASSWORD=your_postgres_password

# Full Database Connection String (Optional Override)
# DATABASE_URL=postgresql://skillbridge:your_postgres_password@localhost:5432/skillbridge_db

# JWT & Security Keys
JWT_SECRET=skillbridge_jwt_secret_key_2026
SECRET_KEY=skillbridge_secret_key_2026

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Local pgAdmin 4 Credentials
PGADMIN_DEFAULT_EMAIL=admin@skillbridge.com
PGADMIN_DEFAULT_PASSWORD=SkillBridge@2026
